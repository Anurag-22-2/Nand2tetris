/**
 * Half adder:
 * Computes the sum of two 1-bit inputs.
 */
CHIP HalfAdder {
    IN a, b;
    OUT sum, carry;

    PARTS:
    Xor(a=a, b=b, out=sum);
    And(a=a, b=b, out=carry);
}
